AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=ap-northeast-2

# Terraform 변수 (DB 자격증명)
TF_VAR_db_user=YOUR_DB_USER
TF_VAR_db_password=YOUR_DB_PASSWORD

# Tailscale Auth Key (로컬 환경에서 프로비저닝 시 필요)
TF_VAR_tailscale_auth_key=YOUR_TAILSCALE_AUTH_KEY

# CI/CD 및 모니터링 관련 키 (필요한 경우)
INFRACOST_API_KEY=YOUR_INFRACOST_API_KEY
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL
